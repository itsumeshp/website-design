# Copy to .env on the VM and fill in real values. Used by docker-compose.prod.yml.

# --- Database (Postgres runs as the 'postgres' service in the compose stack) ---
POSTGRES_USER=fexo
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=fexo
DATABASE_URI=postgres://fexo:CHANGE_ME_strong_password@postgres:5432/fexo

# --- Payload ---
PAYLOAD_SECRET=CHANGE_ME_openssl_rand_hex_32
NODE_ENV=production

# --- Public site URL (used for canonical/OG/sitemap; baked in at build) ---
NEXT_PUBLIC_SERVER_URL=https://your-domain.example

# --- Email (Resend). Leave blank to store leads without email notifications. ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Cloud Run + Neon deploy ---
# Postgres connection string (Neon serverless Postgres, free tier)
DATABASE_URI=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# Media storage: Google Cloud Storage bucket (Cloud Run disk is ephemeral)
GCS_BUCKET=infrion-cms-media
GCP_PROJECT_ID=infrion-technolab
# Public URL of the deployed site (used for canonical/OG/sitemap)
NEXT_PUBLIC_SERVER_URL=https://new.infriontechnolab.com
